# LLM provider configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional OCR / fallback configuration
OCR_ENABLED=true
TESSERACT_CMD=

# Vector store configuration
VECTOR_STORE=chroma
CHROMA_DIR=./tmp/chroma

# App runtime
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# PostgreSQL (Version 2 foundation)
# Replace these local-only credentials in deployed environments.
DATABASE_URL=postgresql+psycopg://invoiceflow:invoiceflow@localhost:5432/invoiceflow
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_ECHO=false

# Amazon Cognito access-token verification (Version 2 foundation)
# Example issuer: https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_EXAMPLE
AUTH_ISSUER=
AUTH_CLIENT_ID=
AUTH_ORGANIZATION_CLAIM=custom:organization_id
AUTH_JWKS_CACHE_SECONDS=300
AUTH_JWKS_TIMEOUT_SECONDS=5
AUTH_CLOCK_SKEW_SECONDS=30

# Private Amazon S3 document storage (Version 2 secure ingestion)
# The application uses the IAM role assigned by AWS. Do not add access keys here.
AWS_REGION=ap-south-1
AWS_ENDPOINT_URL=
S3_BUCKET_NAME=
S3_QUARANTINE_PREFIX=quarantine
S3_VALIDATED_PREFIX=validated
S3_SSE_ALGORITHM=AES256
S3_KMS_KEY_ID=
S3_PRESIGNED_URL_TTL_SECONDS=300

# Amazon SQS asynchronous processing queue
SQS_QUEUE_URL=
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=120
SQS_VISIBILITY_HEARTBEAT_SECONDS=30
SQS_RETRY_BASE_DELAY_SECONDS=30
SQS_RETRY_MAX_DELAY_SECONDS=900
SQS_REDRIVE_MAX_RECEIVE_COUNT=4

# Background worker behavior
WORKER_STALE_JOB_SECONDS=3600
WORKER_EXTRACTOR_MODE=heuristic

# Upload validation limits
UPLOAD_MAX_BYTES=10485760
UPLOAD_MAX_PDF_PAGES=25
UPLOAD_MAX_FILENAME_LENGTH=255
