# LLM provider configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Optional OCR / fallback configuration
OCR_ENABLED=true
TESSERACT_CMD=

# Vector store configuration
VECTOR_STORE=chroma
CHROMA_DIR=./tmp/chroma

# App runtime
APP_ENV=development
HOST=127.0.0.1
PORT=8000

# PostgreSQL (Version 2 foundation)
# Replace these local-only credentials in deployed environments.
DATABASE_URL=postgresql+psycopg://invoiceflow:invoiceflow@localhost:5432/invoiceflow
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_ECHO=false

# Amazon Cognito access-token verification (Version 2 foundation)
# Example issuer: https://cognito-idp.ap-south-1.amazonaws.com/ap-south-1_EXAMPLE
AUTH_ISSUER=
AUTH_CLIENT_ID=
AUTH_ORGANIZATION_CLAIM=custom:organization_id
AUTH_JWKS_CACHE_SECONDS=300
AUTH_JWKS_TIMEOUT_SECONDS=5
AUTH_CLOCK_SKEW_SECONDS=30
